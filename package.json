{
  "name": "roomie-workspace-builder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern .next",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:smoke": "node --test tests/rendered-html.test.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  },
  "type": "module"
}
